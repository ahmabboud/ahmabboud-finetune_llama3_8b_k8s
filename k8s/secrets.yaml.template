---
# HuggingFace token secret
apiVersion: v1
kind: Secret
metadata:
  name: hf-token
  namespace: default
type: Opaque
stringData:
  token: "${HF_TOKEN}"  # Replace with your token or use kubectl create secret
---
# Weights & Biases token secret  
apiVersion: v1
kind: Secret
metadata:
  name: wandb-token
  namespace: default
type: Opaque
stringData:
  key: "${WANDB_API_KEY}"  # Replace with your key or use kubectl create secret
